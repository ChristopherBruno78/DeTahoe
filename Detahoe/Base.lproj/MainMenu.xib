        <customObject id="dws-uz-YmS" userLabel="Unbox Help Popover Controller" customClass="HelpPopoverController">
            <userDefinedRuntimeAttributes>
                <userDefinedRuntimeAttribute type="string" keyPath="helpText">
                    <string key="value">Scans your Applications folder for legacy icons that macOS Tahoe would put into a gray rounded box and enableds each app's own unrestricted icon. Does not work for Apps installed via the Mac App Store.</string>
